# Copy this file to .env and fill it in. Restart serve.mjs after editing.

# Fallback headline / email event name when Luma has not resolved an event yet.
# Once an event is selected (staff console or LUMA_EVENT_ID), the Luma event name wins.
EVENT_NAME=

# --- Luma ---  Luma → Settings → Developer → API Keys. Without a key the wall runs in demo mode.
LUMA_API_KEY=
# Pin the event (evt-...). Persisted in the store after the first resolve / staff switch;
# set this for a fresh deploy so the wall knows which meetup to open on. Leave blank to
# auto-pick the nearest upcoming event (then that choice is saved).
LUMA_EVENT_ID=

# --- Email provider ---
# Explicit pick: resend | mailgun | smtp. If blank, first configured wins: Resend → Mailgun → SMTP.
# Free PaaS hosts (Render etc.) often block outbound SMTP — use Resend or Mailgun there.
EMAIL_PROVIDER=
# Resend (HTTP). Domain must be verified in Resend (e.g. cursorpakistan.com).
RESEND_API_KEY=
# Mailgun (HTTP). Domain must be verified (Sending → Domains). Sandbox only delivers to
# Authorized Recipients, so it is for rehearsal, not a live event.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# EU accounts only: https://api.eu.mailgun.net
MAILGUN_BASE=https://api.mailgun.net
# SMTP (optional). Google Workspace: App Password from https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Sender. For Resend/Mailgun use an address on your verified domain.
# For Gmail SMTP it must be SMTP_USER or a "Send mail as" alias.
EMAIL_FROM=Grok Bot <hello@cursorpakistan.com>
EMAIL_REPLY_TO=
EMAIL_SUBJECT=
# Optional hard override for the event name inside emails (otherwise Luma event name / EVENT_NAME).
EMAIL_EVENT_NAME=
# Rehearsal switches: EMAIL_DRY_RUN=1 logs instead of sending; EMAIL_TEST_TO=you@x.com
# redirects EVERY guest email to that address (subject shows the original recipient).
# Leave EMAIL_TEST_TO empty on event day — a real address here silently hijacks all guest mail.
EMAIL_DRY_RUN=0
EMAIL_TEST_TO=
# EMAIL_OFF=1 disables sending entirely even if a key is present.
EMAIL_OFF=0

# --- Supabase (recommended on hosts with no persistent disk) ---
# Source of truth for allocations, the shared code pool, and the current event id.
# Create the table with the SQL in the README, then paste the project URL and the SERVICE ROLE key
# (Project Settings → API). The service role key bypasses RLS — server-side only, never in a browser.
# Leave blank to use data/state.json instead (fine locally; not durable on free PaaS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Set only if one Supabase project serves more than one wall (e.g. "dev" vs "default").
SUPABASE_ROW_ID=default

# --- codes ---
# Initial seed only. After first boot the pool lives in the store; staff can add more from
# the desk console without redeploying. On a host with no disk, paste the JSON (minified)
# into CODES_JSON — same shape as data/codes.example.json ({"A":[...],"B":[...],"labels":{...}}).
CODES_JSON=

# --- hosting ---
PORT=8787
# Access token: everything except /healthz, the Luma webhook, and /assets requires it.
# Open the wall as /?key=<token>&desk for the staff console.
WALL_TOKEN=
# Public base URL of this server (no trailing slash), e.g. https://wall.cursorpakistan.com
# When set, the server re-registers the Luma webhook (guest.updated) for
# <PUBLIC_URL>/webhooks/luma on every startup.
PUBLIC_URL=
